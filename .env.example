# Copy to .env and adjust for your environment.

# --- Database -----------------------------------------------------------
# Postgres (used by docker-compose / production):
# DATABASE_URL=postgresql+psycopg2://uniquepredict:uniquepredict@localhost:5432/uniquepredict
# SQLite (local dev / no Docker):
DATABASE_URL=sqlite:///./data/uniquepredict.db
# SQLite only: write-ahead logging (readers no longer block on a committing writer)
# and how long a writer waits for another writer, in seconds.
# SQLITE_WAL=true
# SQLITE_BUSY_TIMEOUT_SECONDS=30

# --- Cache ----------------------------------------------------------------
# If unset or unreachable, the app runs with caching disabled (no crash).
REDIS_URL=redis://localhost:6379/0

# --- Vector DB (RAG knowledge base, see rag/README.md) ---------------------
# Local dev (default): leave CHROMA_URL unset — uses a local persistent
# ChromaDB store at CHROMA_PERSIST_DIR, no separate service needed.
# Docker (docker-compose sets this automatically for the api service):
# CHROMA_URL=http://chromadb:8000
CHROMA_PERSIST_DIR=rag/chroma_store

# --- AI analyst agent (see app/agents/README.md) ---------------------------
# Required only for POST /analyst/{match_id}; the rest of the API works fine
# without it. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-5

# --- Injuries (scripts/sync_injuries.py) ------------------------------
# Required only for GET /injuries/{team} and the agent's get_injuries tool to
# return real data; without it they honestly report "not available" rather
# than guessing. Free-tier key: https://dashboard.api-football.com/register
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Leave unset to auto-detect the current season from today's date. Set
# explicitly (e.g. 2024 for the 2024-25 season) to query a past season.
# API_FOOTBALL_SEASON=2025

# --- App --------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_RATE_LIMIT_PER_MINUTE=6000

# --- Elo defaults -----------------------------------------------------
ELO_K_FACTOR=20
ELO_HOME_ADVANTAGE=60
ELO_INITIAL_RATING=1500

# --- ML -----------------------------------------------------------------
MODEL_ARTIFACT_DIR=ml/models

# --- Scheduler (app/scheduler.py) --------------------------------------
# Off by default. Enable in a long-running API process (not in scripts/tests).
# What it fetches and how often follows your API-Football plan and what is left of
# today's quota — there is nothing else to configure.
ENABLE_SCHEDULER=false
