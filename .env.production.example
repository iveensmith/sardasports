# Production settings for docker-compose.prod.yml.
# Copy to .env.production on the SERVER and fill it in. Never commit the filled-in file.

# --- Where the server keeps data (see docs/deployment.md "First-time setup") ----------
# Holds data/, models/ and chroma/. Must be owned by uid 1000: chown -R 1000:1000 /srv/sardasports
DATA_DIR=/srv/sardasports

# --- Cloudflare Tunnel ------------------------------------------------------------------
# Created in the Cloudflare dashboard: Zero Trust > Networks > Tunnels > Create a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# --- The public site (baked into the website at build time) -------------------------------
# The real address, e.g. https://sardasports.com . LEAVE EMPTY until you are ready to be
# indexed: while it is empty the site is noindex and robots.txt disallows everything.
NEXT_PUBLIC_SITE_URL=
# Shown on the About / Privacy / Terms pages. Left empty, those pages say the detail is
# still to be added rather than inventing one.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Accounts, e-mail and payments (all optional until you turn them on) -------------------
# Outgoing mail. Until it is set, account e-mails are written to the Mail page of the admin
# dashboard and not sent, so members cannot confirm their address without you passing the
# link on. Any SMTP service works (Resend, Postmark, Brevo, your domain's mailbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SARDASPORTS <no-reply@yourdomain.com>
# Card payments for premium. Each is used only when its key is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# --- Engine (read by the api container) -----------------------------------------------------
# Retrains every model inside the web process on Mondays at 04:00. Leave it OFF on a small
# server: it held the CPU near 150% for an hour and grew the engine to 3 GB (12 Oct 2026).
ENABLE_WEEKLY_RETRAIN=false
# Nightly database snapshots to keep (data/backups, taken at 02:10). One a night.
BACKUP_KEEP=14
LOG_LEVEL=INFO
# The website is the engine's only client, so one IP makes every request.
API_RATE_LIMIT_PER_MINUTE=6000

# API-Football. The scheduler's results, fixtures, odds and injuries jobs need it. The plan
# (free or paid) is read from the account itself, so upgrading changes the cadence by itself.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# (The same key serves the basketball feed: API-Sports uses one key for its sports.)

# Optional: the AI analyst text. Nothing about the predictions depends on it.
ANTHROPIC_API_KEY=
