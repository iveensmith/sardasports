# syntax=docker/dockerfile:1
#
# The SARDASPORTS prediction engine (FastAPI), used by docker-compose.yml (development)
# and docker-compose.prod.yml (production).
#
# Built from the lockfile, so the versions that run are the versions that were tested.
# Two stages: a builder with a compiler, and a slim runtime that only has what runs.
# Data (the SQLite file, raw downloads) and trained models are mounted as volumes, never
# baked in: see .dockerignore.

FROM python:3.12-slim AS builder

ENV UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# Dependencies first, so a code change does not reinstall them.
# README.md is named in pyproject.toml's metadata, and the build fails without it.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY app ./app
COPY ml ./ml
COPY rag ./rag
COPY scripts ./scripts
COPY alembic ./alembic
COPY alembic.ini ./
RUN uv sync --frozen --no-dev


FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# libgomp is the OpenMP runtime XGBoost and LightGBM load; the slim image does not have it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin app

WORKDIR /app
# The libraries (many thousands of small files) and the code are separate layers, so a
# code change reuses the libraries from cache. No `--chown` on them: the app only reads them
# (bytecode writing is off), and a recursive chown over that many files took over three
# minutes. Only the folders the engine writes to are handed to its user.
COPY --from=builder /app/.venv /app/.venv
COPY app ./app
COPY ml ./ml
COPY rag ./rag
COPY scripts ./scripts
COPY alembic ./alembic
COPY alembic.ini pyproject.toml README.md ./
RUN mkdir -p data ml/models rag/chroma_store \
    && chown -R app:app data ml/models rag/chroma_store

USER app
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health >/dev/null || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
